{
  "name": "@rampspec/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-public-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm check:env && pnpm check:secrets && pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.70.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.7",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
